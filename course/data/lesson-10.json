      "en": "almost, nearly",
      "note": "casi todo = almost everything.",
      "ext": true,
      "example": { "es": "Entiendo casi todo.", "en": "I understand almost everything." }
    },
    {
      "word": "venir",
      "type": "v.",
      "en": "to come",
      "note": "Irregular: vengo, vienes, viene…",
      "ext": true,
      "example": { "es": "¿Puedes venir mañana?", "en": "Can you come tomorrow?" }
    },
    {
