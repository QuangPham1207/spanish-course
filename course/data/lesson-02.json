{
  "lesson": 2,
  "title": "Introducing yourself",
  "words": [
    {
      "word": "llamarse",
      "type": "v.",
      "en": "to be called, to be named",
      "note": "me llamo, te llamas, se llama.",
      "example": { "es": "¿Cómo te llamas? — Me llamo Lan.", "en": "What's your name? — My name is Lan." }
    },
    {
      "word": "¿Cómo se llama usted?",
      "type": "phr.",
      "en": "what's your name? (formal)",
      "note": "Formal; informal: ¿Cómo te llamas?",
      "example": { "es": "¿Cómo se llama usted? — Me llamo Ana.", "en": "What's your name? — My name is Ana." }
    },
    {
      "word": "mucho gusto",
      "type": "phr.",
      "en": "nice to meet you",
      "note": "Reply: igualmente.",
      "example": { "es": "Mucho gusto, señora.", "en": "Nice to meet you, ma'am." }
    },
    {
      "word": "encantado/a",
      "type": "adj.",
      "en": "pleased to meet you",
      "note": "Men say encantado, women encantada.",
      "example": { "es": "Encantada de conocerte.", "en": "Pleased to meet you." }
    },
    {
      "word": "ser",
      "type": "v.",
      "en": "to be (identity / origin)",
      "note": "soy, eres, es, somos, sois, son.",
