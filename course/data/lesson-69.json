{
  "lesson": 69,
  "title": "Religion, race & mestizaje",
  "words": [
    {"word": "mestizo", "type": "adj./n.m.", "en": "mestizo, mixed (Spanish + indigenous)", "note": "Colonial label; today often identity word.", "example": {"es": "Era hijo de español e indígena: mestizo.", "en": "He was the son of a Spaniard and an indigenous woman: mestizo."}},
    {"word": "mestizaje", "type": "n.m.", "en": "mixing, miscegenation", "note": "Central idea; debated today.", "example": {"es": "El mestizaje puede invisibilizar.", "en": "Mestizaje can make people invisible."}},
    {"word": "mezclar", "type": "v.", "en": "to mix", "note": "La fe se mezcló con otra devoción.", "example": {"es": "La fe se mezcló con otra devoción.", "en": "Faith mixed with another devotion."}},
    {"word": "mezcla", "type": "n.f.", "en": "mixture, blend", "note": "Mezcla cultural y religiosa.", "example": {"es": "Es símbolo de mezcla cultural.", "en": "It is a symbol of cultural mixture."}},
    {"word": "criollo", "type": "adj./n.m.", "en": "creole (American-born Spaniard)", "note": "Colonial caste; also cocina criolla.", "example": {"es": "Un criollo era hijo de españoles.", "en": "A criollo was a child of Spaniards."}},
