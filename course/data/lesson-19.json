      "note": "Contar una historia.",
      "example": { "es": "Me contó la historia de la ciudad.", "en": "She told me the history of the city." }
    },
    {
      "word": "al principio",
      "type": "phr.",
      "en": "at first",
      "note": "Opposite: al final.",
