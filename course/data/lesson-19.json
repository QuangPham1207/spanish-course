    },
    {
      "word": "de repente",
      "type": "phr.",
      "en": "suddenly",
      "note": "Signals a preterite event.",
      "example": { "es": "De repente, empezó a llover.", "en": "Suddenly, it started to rain." }
    },
    {
      "word": "conocer",
      "type": "v.",
      "en": "to know; to meet",
      "note": "Conocí = I met.",
      "example": { "es": "Conocí a Sofía en Lima.", "en": "I met Sofía in Lima." }
    },
    {
      "word": "sentirse",
      "type": "v.",
      "en": "to feel",
      "note": "e→ie: me siento, me sentí.",
